# Common
PORT=3000
NODE_ENV=production
CORS_ORIGINS= # Comma-separated list of allowed origins for CORS

# Prometheus, Grafana, Promtail, Loki, Node Exporter, Opentelemetry, Jaeger
PROMETHEUS_PORT=9090
PROMETHEUS_PUSH_GATEWAY_PORT=9091
PROMTAIL_PORT=9080
NODE_EXPORTER_PORT=9100
NESTJS_METRICS_TARGET= # e.g. 10.0.0.55:3000
NODE_EXPORTER_TARGET= # e.g. 10.0.0.55:9100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
ENABLE_LOKI=false
LOKI_PORT=3100
LOKI_API_TOKEN=
OTLP_PORT=4318
OTEL_SERVICE_NAME=nestjs-app
OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. http://jaeger:4318/v1/traces
JAEGER_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAGER_URL=

# PG Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=
DATABASE_URL= # e.g. postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Pagination
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=10

# External Links
GRAFANA_URL=
APP_LOGS_URL=
DEV_DOCS_URL=
SERVICES_HEALTH_URL=

# SQS / ElasticMQ
ENABLE_SQS=false
SQS_ENDPOINT= # e.g. https://sqs.us-east-1.amazonaws.com
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
SQS_ACCOUNT_ID=
SQS_QUEUE_PREFIX=prod
ELASTICMQ_PORT=9324
