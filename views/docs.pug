doctype html
html
  head
    title= title
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    style.
      body {
        background-color: #f8f9fa;
        color: #333;
        font-family: 'Segoe UI', sans-serif;
        padding-top: 80px;
      }
      .header-bar {
        position: fixed;
        top: 0; left: 0; right: 0;
        background-color: #ffffff;
        padding: 1rem 2rem;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .back-button {
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        color: #007bff;
      }
      .doc-item {
        padding: 0.6rem 1rem;
        border-left: 4px solid #007bff;
        background: #fff;
        margin-bottom: 0.5rem;
        border-radius: 6px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
      }
      .doc-item a {
        text-decoration: none;
        color: #333;
        font-weight: 500;
      }
      .doc-item a:hover { color: #007bff; }
      .folder-name {
        font-weight: 600;
        color: #555;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        text-transform: capitalize;
      }

  body
    .header-bar
      a.back-button(href='/v1/dev-tools') &larr; Dev Tools
      h4.mb-0.flex-grow-1.ms-3 Dev Docs
      if user
        span.fw-semibold
          | Welcome,&nbsp;
          span(style='color: #17a2b8; font-weight: 600;') #{user}

    .container.mt-4
      mixin renderDocs(items, depth)
        each item in items
          if item.isDir
            .folder-name(style=`margin-left: ${depth * 1.5}rem`)
              | #{item.name}/
            if item.children && item.children.length
              +renderDocs(item.children, depth + 1)
          else
            .doc-item(style=`margin-left: ${depth * 1.5}rem`)
              a(href=`/v1/dev-tools/docs?file=${item.path}`)= item.name

      if docs && docs.length
        +renderDocs(docs, 0)
      else
        .text-muted.text-center.mt-4 No documentation files found in docs/ directory.
