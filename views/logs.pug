doctype html
html
  head
    title= title
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    style.
      body {
        background-color: #1e1e1e;
        color: #d4d4d4;
        font-family: 'Courier New', monospace;
        padding-top: 80px;
      }
      .header-bar {
        position: fixed;
        top: 0; left: 0; right: 0;
        background-color: #2d2d2d;
        padding: 1rem 2rem;
        box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .back-button {
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        color: #569cd6;
      }
      .header-bar h4 { color: #d4d4d4; }
      .log-files {
        background: #2d2d2d;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
      }
      .log-file-item {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        margin: 0.2rem;
        background: #3c3c3c;
        border-radius: 4px;
        font-size: 0.8rem;
        color: #9cdcfe;
      }
      .log-file-item .size {
        color: #808080;
        font-size: 0.75rem;
      }
      .log-line {
        padding: 2px 8px;
        border-bottom: 1px solid #2d2d2d;
        font-size: 0.82rem;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-all;
      }
      .log-line:hover {
        background-color: #2a2d2e;
      }
      .log-info { color: #4ec9b0; }
      .log-error { color: #f44747; background-color: #2c1b1b; }
      .log-warn { color: #ce9178; }
      .log-debug { color: #808080; }
      .section-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #808080;
        margin-bottom: 0.5rem;
      }
      .log-container {
        background: #1e1e1e;
        border: 1px solid #3c3c3c;
        border-radius: 8px;
        max-height: 70vh;
        overflow-y: auto;
      }

  body
    .header-bar
      a.back-button(href='/v1/dev-tools') &larr; Dev Tools
      h4.mb-0.flex-grow-1.ms-3 Application Logs
      if user
        span.fw-semibold(style='color: #569cd6;')
          | Welcome,&nbsp;
          span(style='color: #4ec9b0; font-weight: 600;') #{user}

    .container-fluid.mt-3.px-4
      .section-label Log Files
      .log-files
        if logFiles && logFiles.length
          each file in logFiles
            span.log-file-item
              | #{file.name}
              span.size  (#{file.size})
        else
          span(style='color: #808080;') No log files found

      .section-label
        | Latest: #{latestFile} (last 100 lines, newest first)
      .log-container
        if recentLines && recentLines.length
          each line in recentLines
            if line.includes('[error]')
              .log-line.log-error= line
            else if line.includes('[warn]')
              .log-line.log-warn= line
            else if line.includes('[debug]')
              .log-line.log-debug= line
            else
              .log-line.log-info= line
        else
          .log-line(style='color: #808080; text-align: center; padding: 2rem;') No log entries found
