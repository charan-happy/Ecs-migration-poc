doctype html
html
  head
    title= title
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    style.
      body {
        background-color: #f8f9fa;
        color: #333;
        font-family: 'Segoe UI', sans-serif;
        padding-top: 80px;
      }
      .header-bar {
        position: fixed;
        top: 0; left: 0; right: 0;
        background-color: #ffffff;
        padding: 1rem 2rem;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .back-button {
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        color: #007bff;
      }
      .breadcrumb-path {
        font-size: 0.85rem;
        color: #888;
        margin-bottom: 1rem;
      }
      .doc-content {
        background: #fff;
        padding: 2rem 2.5rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        line-height: 1.7;
        font-size: 0.95rem;
      }
      .doc-content h1 { font-size: 1.8rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e9ecef; }
      .doc-content h2 { font-size: 1.4rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #444; }
      .doc-content h3 { font-size: 1.15rem; font-weight: 600; margin-top: 1.25rem; margin-bottom: 0.5rem; color: #555; }
      .doc-content p { margin-bottom: 0.75rem; }
      .doc-content code {
        background-color: #f0f0f0;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.88rem;
        color: #c7254e;
        font-family: 'Courier New', monospace;
      }
      .doc-content pre {
        background-color: #1e1e1e;
        color: #d4d4d4;
        padding: 1rem 1.25rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
        margin-bottom: 1rem;
      }
      .doc-content pre code {
        background: none;
        color: inherit;
        padding: 0;
        font-size: inherit;
      }
      .doc-content table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
      }
      .doc-content th, .doc-content td {
        border: 1px solid #dee2e6;
        padding: 0.5rem 0.75rem;
        text-align: left;
      }
      .doc-content th {
        background-color: #f8f9fa;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: #555;
      }
      .doc-content ul, .doc-content ol { padding-left: 1.5rem; margin-bottom: 0.75rem; }
      .doc-content li { margin-bottom: 0.3rem; }
      .doc-content blockquote {
        border-left: 4px solid #007bff;
        padding: 0.5rem 1rem;
        margin: 1rem 0;
        background: #f0f7ff;
        color: #444;
      }
      .doc-content hr { border: none; border-top: 2px solid #e9ecef; margin: 1.5rem 0; }
      .doc-content a { color: #007bff; text-decoration: none; }
      .doc-content a:hover { text-decoration: underline; }
      .doc-content img { max-width: 100%; border-radius: 6px; }

  body
    .header-bar
      a.back-button(href='/v1/dev-tools/docs') &larr; Docs
      h4.mb-0.flex-grow-1.ms-3= fileName
      if user
        span.fw-semibold
          | Welcome,&nbsp;
          span(style='color: #17a2b8; font-weight: 600;') #{user}

    .container.mt-4
      .breadcrumb-path docs/#{breadcrumb}
      .doc-content !{htmlContent}
