generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id              Int       @id @default(autoincrement())
  event_timestamp DateTime? @default(now()) @db.Timestamptz(6)
  requested_api   String?   @db.VarChar(255)
  app_version     String?   @db.VarChar(50)
  system_name     String?   @db.VarChar(100)
  system_version  String?   @db.VarChar(50)
  user_agent      String?
  ip_address      String?   @db.VarChar(45)
  country         String?   @db.VarChar(100)
  host_name       String?   @db.VarChar(255)
  table_name      String?   @db.VarChar(100)
  operation_type  String?   @db.VarChar(50)
  severity        String?   @db.VarChar(20)
  description     String?
  details         Json?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([country], map: "idx_audit_logs_country")
  @@index([event_timestamp], map: "idx_audit_logs_event_timestamp")
  @@index([requested_api], map: "idx_audit_logs_requested_api")
  @@index([severity], map: "idx_audit_logs_severity")
  @@index([table_name, operation_type], map: "idx_audit_logs_table_operation")
}

model db_audit_logs {
  id              Int       @id @default(autoincrement())
  event_timestamp DateTime? @default(now()) @db.Timestamptz(6)
  table_name      String    @db.VarChar(100)
  operation_type  String    @db.VarChar(10)
  db_user         String?   @db.VarChar(100)
  db_name         String?   @db.VarChar(100)
  old_value       Json?
  new_value       Json?
  triggered_by    String?   @default(dbgenerated("CURRENT_USER"))
}

model clinic_patients {
  id                                                               Int          @id @default(autoincrement())
  clinic_id                                                        Int
  patient_id                                                       Int
  assigned_clinician_id                                            Int
  added_by_id                                                      Int
  created_at                                                       DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at                                                       DateTime?    @default(now()) @db.Timestamptz(6)
  is_deleted                                                       Boolean      @default(false)
  is_active                                                        Boolean      @default(true)
  user_clinics_clinic_patients_added_by_idTouser_clinics           user_clinics @relation("clinic_patients_added_by_idTouser_clinics", fields: [added_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_added_by_id")
  clinics                                                          clinics      @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinic_id")
  user_clinics_clinic_patients_assigned_clinician_idTouser_clinics user_clinics @relation("clinic_patients_assigned_clinician_idTouser_clinics", fields: [assigned_clinician_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinic_patients_clinician")
  patients                                                         patients     @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_patient_id")

  @@unique([clinic_id, patient_id], map: "uq_clinic_patients")
}

model clinics {
  id                      Int               @id @default(autoincrement())
  clinic_name             String            @db.VarChar(150)
  description             String?
  address                 String?
  city                    String?           @db.VarChar(100)
  state                   String?           @db.VarChar(100)
  zip_code                String?           @db.VarChar(10)
  country                 String?           @db.VarChar(100)
  phone                   String?           @db.VarChar(20)
  clinic_email            String?           @db.VarChar(100)
  website                 String?           @db.VarChar(255)
  registration_number     String?           @unique @db.VarChar(100)
  license_number          String?           @db.VarChar(100)
  registration_valid_till DateTime?         @db.Date
  tax_id                  String?           @db.VarChar(50)
  clinic_type             String?           @db.VarChar(50)
  logo_id                 Int?
  organization_id         Int
  added_by_id             Int
  deleted_at              DateTime?         @db.Timestamptz(6)
  is_active               Boolean           @default(true)
  created_at              DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?         @default(now()) @db.Timestamptz(6)
  clinic_patients         clinic_patients[]
  organizations           organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinics_organization")
  users                   users             @relation(fields: [added_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinics_added_by")
  media_metadata          media_metadata?   @relation(fields: [logo_id], references: [id], onUpdate: NoAction, map: "fk_clinics_logo")
  user_clinics            user_clinics[]
}

model modules {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  description String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?     @default(now()) @db.Timestamptz(6)
  permissions permissions[]
}

model patients {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  gender           gender_type
  date_of_birth    DateTime          @db.Date
  phone            String?           @db.VarChar(20)
  email            String            @unique @db.VarChar(100)
  address          String?
  city             String?           @db.VarChar(100)
  state            String?           @db.VarChar(100)
  zip_code         String?           @db.VarChar(10)
  country          String?           @db.VarChar(100)
  blood_group      String?           @db.VarChar(5)
  profile_photo_id Int?
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
  clinic_patients  clinic_patients[]
  media_metadata   media_metadata?   @relation(fields: [profile_photo_id], references: [id], onUpdate: NoAction, map: "fk_patients_profile_photo")
}

model permissions {
  id               Int                @id @default(autoincrement())
  permission_type  permission_type
  description      String?
  module_id        Int
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  modules          modules            @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module_id")
  role_permissions role_permissions[]
}

model role_permissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_permission_id")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_id")

  @@unique([role_id, permission_id], map: "uq_role_permissions")
}

model roles {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(100)
  description        String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  role_permissions   role_permissions[]
  user_roles         user_roles[]
  user_organizations user_organizations[]
}

model user_clinics {
  id                                                                  Int               @id @default(autoincrement())
  user_id                                                             Int
  clinic_id                                                           Int
  organization_id                                                     Int
  user_clinical_role                                                  String?           @db.VarChar(50)
  is_deleted                                                          Boolean           @default(false)
  is_active                                                           Boolean           @default(true)
  added_by_id                                                         Int
  created_at                                                          DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at                                                          DateTime?         @default(now()) @db.Timestamptz(6)
  clinic_patients_clinic_patients_added_by_idTouser_clinics           clinic_patients[] @relation("clinic_patients_added_by_idTouser_clinics")
  clinic_patients_clinic_patients_assigned_clinician_idTouser_clinics clinic_patients[] @relation("clinic_patients_assigned_clinician_idTouser_clinics")
  users_user_clinics_added_by_idTousers                               users             @relation("user_clinics_added_by_idTousers", fields: [added_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_clinics_added_by")
  clinics                                                             clinics           @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinic_id")
  organizations                                                       organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_clinics_org")
  users                                                               users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_id")

  @@unique([user_id, clinic_id], map: "uq_user_clinics_user_clinic")
  @@index([organization_id], map: "idx_user_clinics_org_id")
}

model user_roles {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  role_id    Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_id")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_id")
}

model organizations {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique @db.VarChar(150)
  description         String?
  added_by_id         Int
  created_at          DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?            @default(now()) @db.Timestamptz(6)
  clinics             clinics[]
  user_organizations  user_organizations[]
  user_clinics        user_clinics[]
  users               users                @relation(fields: [added_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_organizations_added_by")
}

model user_organizations {
  id              Int            @id @default(autoincrement())
  user_id         Int
  organization_id Int
  role_id         Int
  is_active       Boolean        @default(true)
  is_deleted      Boolean        @default(false)
  added_by_id     Int
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @default(now()) @db.Timestamptz(6)
  users           users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_organizations_user")
  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_organizations_org")
  roles           roles          @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_organizations_role")
  added_by        users          @relation("user_organizations_added_by", fields: [added_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_organizations_added_by")

  @@unique([user_id, organization_id], map: "uq_user_organizations")
  @@index([user_id], map: "idx_user_organizations_user_id")
  @@index([organization_id], map: "idx_user_organizations_org_id")
  @@index([role_id], map: "idx_user_organizations_role_id")
}

model users {
  id                                           Int                  @id @default(autoincrement())
  name                                         String               @db.VarChar(100)
  email                                        String               @unique @db.VarChar(100)
  phone                                        String               @unique @db.VarChar(20)
  address                                      String?
  city                                         String?              @db.VarChar(100)
  state                                        String?              @db.VarChar(100)
  zip_code                                     String?              @db.VarChar(10)
  country                                      String?              @db.VarChar(100)
  profile_photo_id                             Int?
  date_of_birth                                DateTime?            @db.Date
  gender                                       gender_type
  password_hash                                String
  password_changed_at                          DateTime?            @db.Timestamptz(6)
  last_login_at                                DateTime?            @db.Timestamptz(6)
  is_2fa_enabled                               Boolean              @default(false)
  two_fa_enabled_at                            DateTime?            @db.Timestamptz(6)
  is_active                                    Boolean              @default(true)
  is_deleted                                   Boolean              @default(false)
  deleted_at                                   DateTime?            @db.Timestamptz(6)
  created_by                                   Int?
  updated_by                                   Int?
  created_at                                   DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at                                   DateTime?            @default(now()) @db.Timestamptz(6)
  clinics                                      clinics[]
  organizations                                organizations[]
  user_clinics_user_clinics_added_by_idTousers user_clinics[]       @relation("user_clinics_added_by_idTousers")
  user_clinics                                 user_clinics[]
  user_organizations                           user_organizations[]
  user_organizations_added_by                  user_organizations[] @relation("user_organizations_added_by")
  user_otp                                     user_otp[]
  user_roles                                   user_roles?
  users_users_created_byTousers                users?              @relation("users_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_users_created_by")
  other_users_users_created_byTousers          users[]             @relation("users_created_byTousers")
  media_metadata                               media_metadata?      @relation(fields: [profile_photo_id], references: [id], onUpdate: NoAction, map: "fk_users_profile_photo")
  users_users_updated_byTousers                users?              @relation("users_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_users_updated_by")
  other_users_users_updated_byTousers          users[]             @relation("users_updated_byTousers")
}

model media_metadata {
  id         Int        @id @default(autoincrement())
  file_name  String     @db.VarChar(100)
  file_type  String     @db.VarChar(100)
  file_url   String
  file_size  Int
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  clinics    clinics[]
  patients   patients[]
  users      users[]
}

model user_otp {
  id           Int              @id @default(autoincrement())
  user_id      Int
  otp          String           @db.VarChar(10)
  otp_type     otp_purpose_type @default(FORGOT_PASSWORD)
  expires_at   DateTime         @db.Timestamptz(6)
  attempts     Int              @default(0)
  locked_at    DateTime?        @db.Timestamptz(6)
  locked_until DateTime?        @db.Timestamptz(6)
  consumed_at  DateTime?        @db.Timestamptz(6)
  created_at   DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?        @default(now()) @db.Timestamptz(6)
  users        users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_otp_user")

  @@unique([user_id, otp_type], map: "uq_user_otp_type")
}

enum otp_purpose_type {
  FORGOT_PASSWORD
  TWO_FA_VERIFICATION
}

enum permission_type {
  READ
  WRITE
  DELETE
  UPDATE
}

enum gender_type {
  MALE
  FEMALE
  OTHER
}
