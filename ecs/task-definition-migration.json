{
  "family": "migration-task",
  "taskRoleArn": "arn:aws:iam::492267476800:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::492267476800:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "migration-container",
      "image": "492267476800.dkr.ecr.us-east-1.amazonaws.com/reneu-migration:latest",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/migration-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:492267476800:secret:rds!db-36e27d39-88f8-407a-80e1-15c2601e8d28-k8YNTB"
        }
      ]
    }
  ]
}