{
  "family": "migration-task",
  "taskRoleArn": "arn:aws:iam::492267476800:role/reneu-staging-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::492267476800:role/reneu-staging-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "migration-container",
      "image": "492267476800.dkr.ecr.us-east-1.amazonaws.com/reneu-migration:latest",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/migration-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:492267476800:secret:reneu-staging-database-url"
        }
      ]
    }
  ]
}